# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form enquiries are delivered
CONTACT_TO_EMAIL=scott.davidson4@icloud.com

# Verified Resend sending domain address (must be a domain you have verified in Resend).
