# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form enquiries are delivered
CONTACT_TO_EMAIL=scottyboi1981@gmail.com

# Verified Resend sending domain address (must be a domain you have verified in Resend).
# Falls back to onboarding@resend.dev in development if unset.
CONTACT_FROM_EMAIL=enquiries@scotiamaintenance.co.uk

# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://scotiamaintenance.co.uk

# Google Places API (New) key — enables live Google reviews on / and /reviews.
# Console: https://console.cloud.google.com/ → APIs & Services → Credentials.
# Restrict the key to the "Places API (New)" service, and to the server IP or
# leave it unrestricted by referrer (it is only ever used server-side).
# Without this key the site falls back to the reviews placeholder — nothing breaks.
GOOGLE_PLACES_API_KEY=

# Google Place ID for the Scotia Maintenance listing. Defaults to the value in
# lib/reviews.ts, so this only needs setting if the listing ever changes.
GOOGLE_PLACE_ID=ChIJDQAn-FHNJCIRvTpbRuDREIc
